{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "moni 분산 추적 — Tempo 서비스 맵, 레이턴시 분포, 에러 Span, trace_id 검색",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "서비스 맵",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "edges": {},
        "nodes": {}
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "serviceMap",
          "refId": "A",
          "serviceMapQuery": "{}"
        }
      ],
      "title": "서비스 의존성 맵",
      "type": "nodeGraph"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "레이턴시 분포",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 2,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "expr": "histogram_quantile(0.50, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service=~\"$service\"}[$__rate_interval])) by (le, service))",
          "legendFormat": "p50 {{service}}",
          "queryType": "nativeHistogram",
          "refId": "A"
        },
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service=~\"$service\"}[$__rate_interval])) by (le, service))",
          "legendFormat": "p95 {{service}}",
          "queryType": "nativeHistogram",
          "refId": "B"
        },
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "expr": "histogram_quantile(0.99, sum(rate(traces_spanmetrics_duration_milliseconds_bucket{service=~\"$service\"}[$__rate_interval])) by (le, service))",
          "legendFormat": "p99 {{service}}",
          "queryType": "nativeHistogram",
          "refId": "C"
        }
      ],
      "title": "Span 레이턴시 (p50/p95/p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 3,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) by (service)",
          "legendFormat": "에러 {{service}}",
          "queryType": "nativeHistogram",
          "refId": "A"
        },
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\"}[$__rate_interval])) by (service)",
          "legendFormat": "전체 {{service}}",
          "queryType": "nativeHistogram",
          "refId": "B"
        }
      ],
      "title": "Span 요청률 (전체 vs 에러)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Trace 검색",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 23 },
      "id": 4,
      "options": {
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "filters": [
            { "id": "service-name", "operator": "=~", "scope": "resource", "tag": "service.name", "value": "$service", "valueType": "string" }
          ],
          "limit": 20,
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces",
          "query": "{resource.service.name=~\"$service\" && duration > $min_duration}"
        }
      ],
      "title": "Trace 목록 (서비스/최소 지속시간 필터)",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 103,
      "title": "에러 Trace",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 40 },
      "id": 5,
      "options": {
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces",
          "query": "{resource.service.name=~\"$service\" && status = error}"
        }
      ],
      "title": "에러 Trace 목록 (status=error)",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["moni", "tracing", "tempo"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": ".*", "value": ".*" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "name": "service",
        "options": [
          { "selected": true, "text": "전체", "value": ".*" },
          { "selected": false, "text": "payment-service",      "value": "payment-service"      },
          { "selected": false, "text": "user-service",         "value": "user-service"         },
          { "selected": false, "text": "trade-service",        "value": "trade-service"        },
          { "selected": false, "text": "stock-service",        "value": "stock-service"        },
          { "selected": false, "text": "portfolio-service",    "value": "portfolio-service"    },
          { "selected": false, "text": "notification-service", "value": "notification-service" },
          { "selected": false, "text": "ai-service",           "value": "ai-service"           },
          { "selected": false, "text": "api-gateway",          "value": "api-gateway"          }
        ],
        "query": ".*,payment-service,user-service,trade-service,stock-service,portfolio-service,notification-service,ai-service,api-gateway",
        "type": "custom",
        "label": "서비스"
      },
      {
        "current": { "selected": true, "text": "0ms", "value": "0ms" },
        "hide": 0,
        "name": "min_duration",
        "options": [
          { "selected": true,  "text": "0ms",   "value": "0ms"   },
          { "selected": false, "text": "100ms",  "value": "100ms"  },
          { "selected": false, "text": "500ms",  "value": "500ms"  },
          { "selected": false, "text": "1s",     "value": "1s"     },
          { "selected": false, "text": "5s",     "value": "5s"     }
        ],
        "query": "0ms,100ms,500ms,1s,5s",
        "type": "custom",
        "label": "최소 Span 시간"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Distributed Tracing",
  "uid": "moni-distributed-tracing",
  "version": 1
}
