#==================================================================
# Database
#==================================================================

# User DB
USER_DB_USERNAME=
USER_DB_PASSWORD=
USER_DB_URL=

# Portfolio DB
PORTFOLIO_DB_USERNAME=
PORTFOLIO_DB_PASSWORD=
PORTFOLIO_DB_URL=

# Stock DB
STOCK_DB_USERNAME=
STOCK_DB_PASSWORD=
STOCK_DB_URL=

# Notification DB
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_DB_URL=

# Trade DB
TRADE_DB_USERNAME=
TRADE_DB_PASSWORD=
TRADE_DB_URL=

# Payment DB
PAYMENT_DB_USERNAME=
PAYMENT_DB_PASSWORD=
PAYMENT_DB_URL=

# AI DB
AI_DB_USERNAME=
AI_DB_PASSWORD=
AI_DB_URL=

#==================================================================
# Cache
#==================================================================

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# Redis Cluster
# 로컬 JVM 실행: 127.0.0.1:7000,127.0.0.1:7001,127.0.0.1:7002
REDIS_CLUSTER_HOST=
REDIS_CLUSTER_PORT_0=
REDIS_CLUSTER_PORT_1=
REDIS_CLUSTER_PORT_2=
REDIS_CLUSTER_PASSWORD=
REDIS_NODES=

#==================================================================
# Message Queue
#==================================================================

# Kafka / Zookeeper (host port)
KAFKA_PORT=
ZOOKEEPER_PORT=

# Kafka Bootstrap
KAFKA_HOST_IP=
KAFKA_BOOTSTRAP_SERVERS=

#==================================================================
# Security
#==================================================================

# JWT
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=
JWT_REFRESH_TOKEN_EXPIRATION=
GATEWAY_SECRET=

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# OAuth - Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Okta (admin-service)
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_ISSUER_URI=

# Okta (Grafana)
OKTA_GRAFANA_CLIENT_ID=
OKTA_GRAFANA_CLIENT_SECRET=
OKTA_GRAFANA_ISSUER_URI=

# CORS
CORS_ALLOWED_ORIGINS=

#==================================================================
# Observability
#==================================================================

# OpenTelemetry — Spring Boot 서비스가 Tempo로 트레이스 전송
# 로컬: http://localhost:4317  (monitoring/ 스택을 로컬에서 실행하는 경우)
# 운영: http://<monitor-ec2-private-ip>:4317  (monitor-ec2 Private IP)
OTEL_EXPORTER_OTLP_ENDPOINT=

# 분리 배포(monitoring/ 레포)를 사용하면 아래 값은 monitoring/.env 에서 관리
TEMPO_GRPC_PORT=4317
LOKI_PORT=3100
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# 로컬: admin/admin  |  운영: Okta SSO 사용
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=

#==================================================================
# Infrastructure
#==================================================================

# EC2 Private IPs (서비스 간 참조용)
# SERVICE_PRIVATE_IP  : 앱 서비스 EC2 (docker-compose.yml 실행 서버)
# INFRA_PRIVATE_IP    : 인프라 EC2 (docker-compose.infra.yml 실행 서버) — DB URL / REDIS_HOST / KAFKA_HOST_IP 에 직접 반영 필요

SERVICE_PRIVATE_IP=
INFRA_PRIVATE_IP=

# ECR (docker-compose.prod.yml 사용 시 필요)
ECR_REGISTRY=

#==================================================================
# External API
#==================================================================

# Naver Client
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_BASE_URL=

# Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=

# KIS (한국투자증권)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_WS_TR_ID=

# Toss PG
TOSS_SECRET_KEY=